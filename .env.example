# Copy to .env.local (gitignored). Validated by src/config/env.ts with Zod —
# a missing or malformed value fails fast with a readable error message.

# --- Server only (no NEXT_PUBLIC_ prefix; never exposed to the browser) ---

# FastAPI backend base URL, proxied by the BFF gateway (src/app/api/**).
API_BASE_URL=http://localhost:8000

# Set to "true" to log full upstream error bodies server-side.
API_DEBUG=false

# --- Client (must be prefixed NEXT_PUBLIC_) ---

# Enables the bundle analyzer during `next build`.
NEXT_PUBLIC_ENABLE_ANALYZER=false

# Fixture mode (phase 4, item 37). With "1", the chat and llm modules answer
# from in-memory fixtures instead of the BFF, so the whole chat UI is
# developable before the backend has LLM provider adapters. Leave at "0" for
# real usage — the BFF is the only source of truth then.
NEXT_PUBLIC_MOCK=0

# NOTE: the browser never calls the backend directly, so no public API URL is
# ever needed (see .agent/API_CONTEXT.txt).

# --- Notes on the session (src/server/session.ts) ---
#
# The BFF sets two httpOnly cookies itself — `at` (access JWT, ~30 min) and
# `rt` (refresh token, 7 d default) — and clears/rotates them automatically.
# They are NOT configured here: they are issued by POST /api/auth/* and never
# exposed to browser JavaScript.
#
# In production, set COOKIE_SECURE behaviour via NODE_ENV=production, which
# makes both cookies `secure` (they are then HTTPS-only).
#
# Requires Node 20+ for the global `fetch`/`AbortSignal.timeout` the proxy uses.
